<idea-plugin>
    <vendor url="https://github.com/dtretyakov">Dmitry Tretyakov</vendor>

    <description><![CDATA[
        Garmin Connect IQ development in IntelliJ IDEA: Monkey C editing, building, running in the
        Connect IQ simulator and debugging.
        <p>
        The plugin brings no language model of its own. Code intelligence comes from the language
        server Garmin ships in the Connect IQ SDK, and building, running and debugging drive the
        SDK's own tools, so everything stays in step with the SDK the user has installed.
        </p>
        <p>Requires the Connect IQ SDK, installed with Garmin's SDK Manager.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <dependencies>
        <!-- The test tree the Connect IQ test runner's output is turned into. -->
        <module name="intellij.platform.testRunner"/>
        <module name="intellij.platform.smRunner"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Monkey C"
            language="MonkeyC"
            extensions="mc;mcgen;mb"
            implementationClass="com.github.dtretyakov.monkeyc.lang.MonkeyCFileType"
            fieldName="INSTANCE"/>
        <fileType
            name="Jungle"
            language="Jungle"
            extensions="jungle"
            implementationClass="com.github.dtretyakov.monkeyc.lang.JungleFileType"
            fieldName="INSTANCE"/>
        <fileType
            name="MSS"
            language="MSS"
            extensions="mss"
            implementationClass="com.github.dtretyakov.monkeyc.lang.MssFileType"
            fieldName="INSTANCE"/>

        <!--
          A `.barrel` is a zip. `barrelbuild` packs the barrel's unmodified source under
          `content/`, so telling the platform it is an archive is what lets JarFileSystem mount it
          and the library node show real Monkey C rather than one opaque binary file.

          Name and extensions only: this adds an extension to a file type that already exists, and
          repeating its `implementationClass` here would make it a second registration of ARCHIVE,
          which the platform drops without a word. The self-check mounts a probe barrel rather than
          trusting this line.
        -->
        <fileType name="ARCHIVE" extensions="barrel"/>

        <!--
          The SDK's API surface, and the IR the compiler writes into bin/. Its own language, not
          another extension on Monkey C: LSP4IJ sends didOpen for every file mapped to a language
          the server serves, and handing the server its own api.mir would light the file up red.
          There is deliberately no languageMapping for it below.
        -->
        <fileType
            name="Connect IQ API"
            language="ConnectIqApi"
            extensions="mir"
            implementationClass="com.github.dtretyakov.monkeyc.lang.ApiMirFileType"
            fieldName="INSTANCE"/>

        <lang.parserDefinition
            language="MonkeyC"
            implementationClass="com.github.dtretyakov.monkeyc.lang.MonkeyCParserDefinition"/>
        <lang.parserDefinition
            language="Jungle"
            implementationClass="com.github.dtretyakov.monkeyc.lang.JungleParserDefinition"/>
        <lang.parserDefinition
            language="MSS"
            implementationClass="com.github.dtretyakov.monkeyc.lang.MssParserDefinition"/>
        <lang.parserDefinition
            language="ConnectIqApi"
            implementationClass="com.github.dtretyakov.monkeyc.lang.ApiMirParserDefinition"/>

        <lang.syntaxHighlighterFactory
            language="MonkeyC"
            implementationClass="com.github.dtretyakov.monkeyc.lang.MonkeyCSyntaxHighlighterFactory"/>
        <lang.syntaxHighlighterFactory
            language="Jungle"
            implementationClass="com.github.dtretyakov.monkeyc.lang.JungleSyntaxHighlighterFactory"/>
        <lang.syntaxHighlighterFactory
            language="MSS"
            implementationClass="com.github.dtretyakov.monkeyc.lang.MssSyntaxHighlighterFactory"/>
        <!-- The IR is Monkey C's syntax with annotations and empty bodies; the same lexer colours it. -->
        <lang.syntaxHighlighterFactory
            language="ConnectIqApi"
            implementationClass="com.github.dtretyakov.monkeyc.lang.MonkeyCSyntaxHighlighterFactory"/>

        <lang.commenter language="MonkeyC" implementationClass="com.github.dtretyakov.monkeyc.lang.MonkeyCCommenter"/>
        <lang.commenter language="Jungle" implementationClass="com.github.dtretyakov.monkeyc.lang.JungleCommenter"/>
        <lang.commenter language="MSS" implementationClass="com.github.dtretyakov.monkeyc.lang.MssCommenter"/>

        <lang.braceMatcher language="MonkeyC" implementationClass="com.github.dtretyakov.monkeyc.lang.MonkeyCBraceMatcher"/>
        <lang.braceMatcher language="Jungle" implementationClass="com.github.dtretyakov.monkeyc.lang.JungleBraceMatcher"/>
        <lang.braceMatcher language="MSS" implementationClass="com.github.dtretyakov.monkeyc.lang.MssBraceMatcher"/>

        <!--
          Enter, and where the caret lands after it. The platform gets this from the formatter, and
          there is no formatter here - a formatter needs a syntax tree with blocks in it, and the
          server offers no formatting of its own either. lineIndentProvider is the platform's answer
          for a language that is lexed but not parsed.
        -->
        <lineIndentProvider implementation="com.github.dtretyakov.monkeyc.lang.MonkeyCLineIndentProvider"/>

        <lang.quoteHandler language="MonkeyC" implementationClass="com.github.dtretyakov.monkeyc.lang.MonkeyCQuoteHandler"/>
        <lang.quoteHandler language="Jungle" implementationClass="com.github.dtretyakov.monkeyc.lang.JungleQuoteHandler"/>
        <lang.quoteHandler language="MSS" implementationClass="com.github.dtretyakov.monkeyc.lang.MssQuoteHandler"/>

        <annotator language="MonkeyC" implementationClass="com.github.dtretyakov.monkeyc.lang.MonkeyCAnnotator"/>

        <colorSettingsPage implementation="com.github.dtretyakov.monkeyc.lang.MonkeyCColorSettingsPage"/>

        <postStartupActivity implementation="com.github.dtretyakov.monkeyc.lsp.MonkeyCServerLifecycle"/>
        <postStartupActivity implementation="com.github.dtretyakov.monkeyc.project.MonkeyCProjectSetup"/>

        <configurationType
            implementation="com.github.dtretyakov.monkeyc.run.MonkeyCRunConfigurationType"/>
        <runConfigurationProducer
            implementation="com.github.dtretyakov.monkeyc.run.MonkeyCRunConfigurationProducer"/>
        <runConfigurationProducer
            implementation="com.github.dtretyakov.monkeyc.run.MonkeyCTestConfigurationProducer"/>
        <runLineMarkerContributor
            language="MonkeyC"
            implementationClass="com.github.dtretyakov.monkeyc.run.MonkeyCTestRunLineMarkerContributor"/>


        <notificationGroup id="Monkey C" displayType="BALLOON"/>

        <newProjectWizard.generator
            implementation="com.github.dtretyakov.monkeyc.ui.wizard.ConnectIqNewProjectWizard"/>

        <fileEditorProvider
            implementation="com.github.dtretyakov.monkeyc.ui.manifest.ManifestEditorProvider"/>

        <editorNotificationProvider
            implementation="com.github.dtretyakov.monkeyc.ui.MissingSdkNotification"/>

        <!--
          The SDK and the project's barrels, under External Libraries. Everything a Monkey C
          project depends on lives outside it, and until now none of it was visible to the IDE.
        -->
        <additionalLibraryRootsProvider
            implementation="com.github.dtretyakov.monkeyc.library.ConnectIqLibraryProvider"/>

        <!--
          Going to a Toybox symbol, and finding one by name.

          Garmin's server indexes api.mir and lands Type and Call Hierarchy in it, but its
          DefinitionContext searches only the workspace's own files, so textDocument/definition on
          WatchUi.Menu2 comes back empty - here and in VS Code alike. Registered last, so this runs
          only when LSP4IJ has already declined, which is exactly the SDK's own symbols.
        -->
        <gotoDeclarationHandler
            order="last"
            implementation="com.github.dtretyakov.monkeyc.navigation.ApiMirGotoDeclarationHandler"/>
        <gotoSymbolContributor
            implementation="com.github.dtretyakov.monkeyc.navigation.ApiMirGotoSymbolContributor"/>
        <gotoClassContributor
            implementation="com.github.dtretyakov.monkeyc.navigation.ApiMirGotoClassContributor"/>

        <appStarter
            id="monkeyCSelfCheck"
            implementation="com.github.dtretyakov.monkeyc.ui.SelfCheckStarter"/>

        <projectConfigurable
            parentId="language"
            id="settings.monkeyc"
            displayName="Monkey C"
            instance="com.github.dtretyakov.monkeyc.ui.MonkeyCConfigurable"/>

        <!--
          Six features the SDK's language server already answers, and LSP4IJ already implements,
          that were reaching nobody.

          LSP4IJ registers these six extension points only for `language="TEXT"` and
          `language="textmate"` - the two languages it can name statically for an abstract file
          type. A plugin with a Language of its own gets the rest of LSP4IJ for free, because
          those registrations are language-agnostic, and gets nothing from these six unless it
          names its own language itself. That is what the block below does; the classes are
          LSP4IJ's own, and public.

          Everything here is gated at run time by LSP4IJ on the server's dynamic registrations, so
          a language the server declines to answer for simply produces nothing.
        -->
        <lang.psiStructureViewFactory
            language="MonkeyC"
            implementationClass="com.redhat.devtools.lsp4ij.features.documentSymbol.LSPDocumentSymbolStructureViewFactory"/>
        <lang.psiStructureViewFactory
            language="Jungle"
            implementationClass="com.redhat.devtools.lsp4ij.features.documentSymbol.LSPDocumentSymbolStructureViewFactory"/>
        <lang.psiStructureViewFactory
            language="MSS"
            implementationClass="com.redhat.devtools.lsp4ij.features.documentSymbol.LSPDocumentSymbolStructureViewFactory"/>

        <!--
          The API file gets its outline and its folding from the index instead of from the server,
          which never sees it. Twenty-seven thousand lines in one file are unreadable as text and
          browsable as a tree.
        -->
        <lang.psiStructureViewFactory
            language="ConnectIqApi"
            implementationClass="com.github.dtretyakov.monkeyc.lang.ApiMirStructureViewFactory"/>
        <lang.foldingBuilder
            language="ConnectIqApi"
            implementationClass="com.github.dtretyakov.monkeyc.lang.ApiMirFoldingBuilder"/>

        <!-- The client already declares `foldingRange.lineFoldingOnly`; the server registers the
             request. Only the IDE side was missing. -->
        <lang.foldingBuilder
            language="MonkeyC"
            order="first"
            implementationClass="com.redhat.devtools.lsp4ij.features.foldingRange.LSPFoldingRangeBuilder"/>
        <lang.foldingBuilder
            language="Jungle"
            order="first"
            implementationClass="com.redhat.devtools.lsp4ij.features.foldingRange.LSPFoldingRangeBuilder"/>
        <lang.foldingBuilder
            language="MSS"
            order="first"
            implementationClass="com.redhat.devtools.lsp4ij.features.foldingRange.LSPFoldingRangeBuilder"/>

        <!-- Ctrl+P over a Toybox call. RequiredFieldsFilter has been repairing this request on the
             wire for some time; until now nothing in the editor ever sent it. -->
        <codeInsight.parameterInfo
            language="MonkeyC"
            implementationClass="com.redhat.devtools.lsp4ij.features.signatureHelp.LSPParameterInfoHandler"/>

        <!-- Ctrl+[ and Ctrl+], off the same folding ranges. -->
        <codeBlockProvider
            language="MonkeyC"
            order="first"
            implementationClass="com.redhat.devtools.lsp4ij.features.codeBlockProvider.LSPCodeBlockProvider"/>

        <typeHierarchyProvider
            language="MonkeyC"
            implementationClass="com.redhat.devtools.lsp4ij.features.typeHierarchy.LSPTypeHierarchyProvider"/>
        <callHierarchyProvider
            language="MonkeyC"
            implementationClass="com.redhat.devtools.lsp4ij.features.callHierarchy.LSPCallHierarchyProvider"/>
    </extensions>

    <applicationListeners>
        <!--
          Both signals are application-wide: the SDK is chosen once for the machine, and the VFS
          has one bus. Listening once and telling every open project beats a subscription per
          project.
        -->
        <listener
            class="com.github.dtretyakov.monkeyc.library.ConnectIqLibraryWatcher"
            topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener
            class="com.github.dtretyakov.monkeyc.library.ConnectIqLibraryWatcher"
            topic="com.github.dtretyakov.monkeyc.project.ConnectIqSdkListener"/>
    </applicationListeners>

    <actions>
        <action
            id="MonkeyC.BuildApp"
            class="com.github.dtretyakov.monkeyc.ui.BuildAppAction"
            text="Build Connect IQ App"
            description="Compiles the app for the simulator, without starting it">
            <add-to-group group-id="BuildMenu" anchor="last"/>
        </action>
        <action
            id="MonkeyC.BuildForWatch"
            class="com.github.dtretyakov.monkeyc.ui.BuildForWatchAction"
            text="Build Connect IQ App for Watch"
            description="Compiles a .prg to copy to GARMIN/APPS over USB; a simulator build will not run on the watch">
            <add-to-group group-id="BuildMenu" anchor="last"/>
        </action>
        <action
            id="MonkeyC.EditProducts"
            class="com.github.dtretyakov.monkeyc.ui.EditProductsAction"
            text="Edit Connect IQ Products..."
            description="Chooses which devices this project is built for">
            <add-to-group group-id="BuildMenu" anchor="last"/>
        </action>
        <action
            id="MonkeyC.Export"
            class="com.github.dtretyakov.monkeyc.ui.ExportAction"
            text="Export Connect IQ App"
            description="Builds a signed .iq for the Connect IQ Store, for every device the manifest declares">
            <add-to-group group-id="BuildMenu" anchor="last"/>
        </action>

        <!--
          The simulator is started by a run and never closed by one, which is right: it holds the
          state being looked at. Closing it is therefore something only the user can ask for.
        -->
        <!--
          The device selector, in the run widget just past Run and Debug. A Connect IQ executable
          is built for one watch, so this is not a preference tucked away in a dialog: it is what
          the run is, and switching it - a round face, then a square one - is most of testing a
          watch app.
        -->
        <!--
          The follow-up the SDK's server asks for after completing a function call.

          MonkeyCCompletionItemBuilder attaches `monkeyc.functionCompletion` to any function that
          takes parameters, exactly as it attaches the standard `editor.action.triggerSuggest` to a
          module — insert `name()`, put the caret between the parens, then show the parameters.
          LSP4IJ resolves an LSP command by looking for an IDE action with that id, and finding
          none it told the user, over and over, that a command was missing.

          It is the same follow-up LSP4IJ already implements for VS Code's own
          `editor.action.triggerParameterHints`, so that class serves it directly. This only shows
          anything because codeInsight.parameterInfo is now registered for Monkey C above; before
          that there would have been nothing behind the command either.
        -->
        <action
            id="monkeyc.functionCompletion"
            class="com.redhat.devtools.lsp4ij.commands.editor.TriggerParameterHintsAction"
            text="Show Connect IQ Parameter Info"
            description="Shown after completing a call to a function that takes parameters"/>

        <action
            id="MonkeyC.OpenApiDocumentation"
            class="com.github.dtretyakov.monkeyc.ui.OpenApiDocumentationAction"
            text="Connect IQ API Documentation"
            description="Opens Garmin's own page for the symbol under the caret, from the installed SDK"
            use-shortcut-of="ExternalJavaDoc">
            <!--
              Borrowing the platform's External Documentation shortcut rather than declaring one.
              Shift+F1 is what a developer already presses for this, and taking the binding by
              reference means no second action claims it and no keymap conflict is reported: the
              action is only enabled in a Monkey C or API file, so the two never compete.
            -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <action
            id="MonkeyC.SelectDevice"
            class="com.github.dtretyakov.monkeyc.ui.SelectDeviceAction"
            text="Connect IQ Device"
            description="Chooses the watch that Build, Run and Debug target">
            <add-to-group
                group-id="RunToolbarMainActionGroup"
                anchor="after"
                relative-to-action="RunToolbarTopLevelExecutorActionGroup"/>
        </action>

        <group id="MonkeyC.Simulator" text="Connect IQ Simulator" popup="true">
            <action
                id="MonkeyC.RestartSimulator"
                class="com.github.dtretyakov.monkeyc.ui.RestartSimulatorAction"
                text="Restart Simulator"
                description="Closes the Connect IQ simulator and starts it again"/>
            <action
                id="MonkeyC.StopSimulator"
                class="com.github.dtretyakov.monkeyc.ui.StopSimulatorAction"
                text="Stop Simulator"
                description="Closes the Connect IQ simulator"/>
            <add-to-group group-id="RunMenu" anchor="last"/>
        </group>
    </actions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server
            id="monkeyc"
            name="Monkey C"
            factoryClass="com.github.dtretyakov.monkeyc.lsp.MonkeyCLanguageServerFactory">
            <description><![CDATA[
                The language server Garmin ships in the Connect IQ SDK, at
                <code>bin/LanguageServer.jar</code>. It is found through the SDK Manager's
                <code>current-sdk.cfg</code>, so it is always the SDK the user has selected.
            ]]></description>
        </server>

        <!--
          The server also serves the resource XML of a project, which is why plain XML is mapped
          too; the document matcher keeps that to files inside a Connect IQ project.
        -->
        <languageMapping language="MonkeyC" serverId="monkeyc" languageId="monkeyc"/>
        <languageMapping language="Jungle" serverId="monkeyc" languageId="jungle"/>
        <languageMapping language="MSS" serverId="monkeyc" languageId="mss"/>
        <languageMapping
            language="XML"
            serverId="monkeyc"
            languageId="xml"
            documentMatcher="com.github.dtretyakov.monkeyc.lsp.ConnectIqXmlMatcher"/>

        <debugAdapterServer
            id="monkeyc"
            name="Monkey C"
            factoryClass="com.github.dtretyakov.monkeyc.dap.MonkeyCDebugAdapterFactory">
            <description><![CDATA[
                The debug adapter Garmin ships in the Connect IQ SDK. It is started from
                <code>bin/LanguageServer.jar</code>, which is the only jar in the SDK that carries
                both the adapter and the gson it needs.
            ]]></description>
        </debugAdapterServer>
    </extensions>
</idea-plugin>
